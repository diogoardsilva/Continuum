<Window x:Class="Continuum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Continuum"
        Width="420" Height="860"
        MinWidth="260" MinHeight="520"
        Background="#1C1C1E"
        WindowStartupLocation="CenterScreen">
    <!-- iPhone 15 screen is 1179x2556; the frame keeps that aspect ratio. -->
    <Viewbox Margin="16" Stretch="Uniform">
        <Border Width="393" Height="852"
                CornerRadius="55"
                BorderBrush="#3A3A3C" BorderThickness="10"
                Background="Black"
                ClipToBounds="True">
            <Grid x:Name="Screen">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Continuum"
                               Foreground="White" FontSize="30" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusText"
                               Text="À espera do iPhone…"
                               Foreground="#8E8E93" FontSize="16" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="300"/>
                </StackPanel>
            </Grid>
        </Border>
    </Viewbox>
</Window>
