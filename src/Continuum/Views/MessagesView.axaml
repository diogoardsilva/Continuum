<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Continuum.ViewModels"
             x:Class="Continuum.Views.MessagesView"
             x:DataType="vm:MessagesViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource IosBackground}">
    <TextBlock Grid.Row="0" Classes="largeTitle" Text="Mensagens" Margin="16,4,16,8"/>
    <TextBox Grid.Row="1" Classes="search" Watermark="Pesquisar" Text="{Binding Search}" Margin="16,0,16,8"/>
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConversationItem">
            <Button Classes="plain" Command="{Binding Open}">
              <Grid ColumnDefinitions="Auto,*" Margin="16,0,0,0">
                <ContentControl Grid.Column="0" Content="{Binding Avatar}" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,10,16,10">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" Classes="headline"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Date}" Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Preview}" Classes="secondary"
                             TextWrapping="Wrap" MaxLines="2" Margin="0,2,0,0"/>
                </Grid>
                <Border Grid.Column="1" Classes="separator"/>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
