<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Continuum.ViewModels"
             x:Class="Continuum.Views.ConversationView"
             x:DataType="vm:ConversationViewModel">
  <UserControl.Styles>
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MaxWidth" Value="270"/>
      <Setter Property="Background" Value="{DynamicResource IosBubbleIncoming}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.bubble.mine">
      <Setter Property="Background" Value="{DynamicResource IosBlue}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="Border.bubble.mine.sms">
      <Setter Property="Background" Value="{DynamicResource IosGreen}"/>
    </Style>
    <Style Selector="Border.bubble TextBlock.text">
      <Setter Property="Foreground" Value="{DynamicResource IosBubbleIncomingText}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextTrimming" Value="None"/>
    </Style>
    <Style Selector="Border.bubble.mine TextBlock.text">
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource IosBackground}">
    <!-- Header: back button, avatar and name -->
    <Grid Grid.Row="0" Background="{DynamicResource IosBar}">
      <Button Classes="plain nav" Command="{Binding Main.BackCommand}" Margin="8,0" VerticalAlignment="Top">
        <TextBlock Classes="blue" Text="‹" FontSize="34" Margin="4,-4,0,0"/>
      </Button>
      <StackPanel HorizontalAlignment="Center" Spacing="2" Margin="60,4,60,8">
        <ContentControl Content="{Binding Avatar}" Width="48" Height="48" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding ConversationTitle}" FontSize="12" HorizontalAlignment="Center"/>
      </StackPanel>
      <Border Classes="separator"/>
    </Grid>

    <ScrollViewer x:Name="Scroller" Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Rows}" Margin="12,8,12,12">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:TimeRow">
            <TextBlock Text="{Binding Text}" Classes="caption" HorizontalAlignment="Center" Margin="0,12,0,6"/>
          </DataTemplate>
          <DataTemplate DataType="vm:BubbleRow">
            <StackPanel Margin="0,2">
              <TextBlock Text="{Binding SenderName}" Classes="caption" Margin="14,4,0,2" IsVisible="{Binding ShowSender}"/>
              <Border Classes="bubble" Classes.mine="{Binding IsFromMe}" Classes.sms="{Binding IsSms}" IsVisible="{Binding HasText}">
                <TextBlock Classes="text" Text="{Binding Text}"/>
              </Border>
              <Border CornerRadius="18" ClipToBounds="True" MaxWidth="240" IsVisible="{Binding HasImage}"
                      HorizontalAlignment="{Binding IsFromMe, Converter={x:Static vm:Converters.MineToAlignment}}">
                <Image Source="{Binding Image}" Stretch="Uniform"/>
              </Border>
              <Border Classes="bubble" Classes.mine="{Binding IsFromMe}" Classes.sms="{Binding IsSms}" IsVisible="{Binding HasFile}">
                <TextBlock Classes="text" Text="{Binding AttachmentName, StringFormat='Anexo: {0}'}"/>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </ScrollViewer>

    <!-- Compose bar (sending comes with the Bluetooth link) -->
    <Grid Grid.Row="2" ColumnDefinitions="*" Margin="12,6,12,8">
      <TextBox Classes="search" CornerRadius="18" Watermark="iMessage" IsEnabled="False"/>
    </Grid>
  </Grid>
</UserControl>
