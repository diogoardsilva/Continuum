<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Continuum.ViewModels"
             x:Class="Continuum.Views.PhotoDetailView"
             x:DataType="vm:PhotoDetailViewModel">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource IosBackground}">
    <Grid Grid.Row="0">
      <Button Classes="plain nav" Command="{Binding Main.BackCommand}" Margin="8,4">
        <TextBlock Classes="blue" Text="‹ Fotos"/>
      </Button>
      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ProgressBar Grid.Row="1" IsIndeterminate="True" Width="120" VerticalAlignment="Center"
                 IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}"/>
    <Image Grid.Row="1" Source="{Binding Image}" Stretch="Uniform"/>
  </Grid>
</UserControl>
