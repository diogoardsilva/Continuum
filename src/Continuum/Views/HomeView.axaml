<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Continuum.ViewModels"
             x:Class="Continuum.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="AppIcon" x:DataType="vm:AppTile">
      <Button Classes="plain" Command="{Binding Open}" HorizontalAlignment="Center">
        <StackPanel Spacing="6" Width="76">
          <Border Width="62" Height="62" CornerRadius="15" Background="{Binding Color}" HorizontalAlignment="Center"
                  BoxShadow="0 2 6 0 #40000000">
            <PathIcon Data="{Binding Icon}" Foreground="White" Width="34" Height="34"/>
          </Border>
          <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="*,Auto,Auto">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#1E3C72" Offset="0"/>
        <GradientStop Color="#6A3093" Offset="0.55"/>
        <GradientStop Color="#E96443" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <!-- Lock-screen style date and time widget. -->
    <StackPanel Grid.Row="0" Margin="0,84,0,0" HorizontalAlignment="Center">
      <TextBlock Text="{Binding Today}" Foreground="#E6FFFFFF" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding Time}" Foreground="White" FontSize="88" FontWeight="Bold" HorizontalAlignment="Center"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding Source, StringFormat='Dados: {0}'}" Foreground="#CCFFFFFF" FontSize="11"
               HorizontalAlignment="Center" Margin="16,0,16,8" TextWrapping="NoWrap"/>

    <!-- Dock -->
    <Border Grid.Row="2" Margin="12,0,12,30" Padding="8,12" CornerRadius="30" Background="#40FFFFFF">
      <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppIcon}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>
  </Grid>
</UserControl>
