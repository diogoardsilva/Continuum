<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Continuum.ViewModels"
             x:Class="Continuum.Views.ContactsAppView"
             x:DataType="vm:ContactsAppViewModel">
  <Grid ColumnDefinitions="300,*">
    <Grid Grid.Column="0" RowDefinitions="44,Auto,*,Auto">
      <TextBox Grid.Row="1" Classes="search" Watermark="Pesquisar" Text="{Binding Search}" Margin="12,0,12,8"/>
      <ListBox Grid.Row="2" Classes="sidebar" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:ContactHeader">
            <TextBlock Text="{Binding Letter}" Classes="secondary headline" FontSize="12" Margin="0,8,0,0"/>
          </DataTemplate>
          <DataTemplate DataType="vm:ContactItem">
            <Grid ColumnDefinitions="Auto,*">
              <ContentControl Grid.Column="0" Content="{Binding Avatar}" Width="26" Height="26" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
      <TextBlock Grid.Row="3" Text="{Binding Count, StringFormat='{}{0} contactos'}" Classes="caption" HorizontalAlignment="Center" Margin="0,8"/>
    </Grid>

    <Border Grid.Column="1" Classes="pane">
      <ScrollViewer DataContext="{Binding Card}" x:DataType="vm:ContactCard">
        <StackPanel Spacing="16" Margin="48,56,48,32" MaxWidth="520">
          <ContentControl Content="{Binding Avatar}" Width="120" Height="120" HorizontalAlignment="Center"/>
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Organization}" Classes="secondary" HorizontalAlignment="Center" IsVisible="{Binding HasOrganization}"/>
          </StackPanel>
          <Border Classes="card" Background="{DynamicResource IosGroupedBackground}">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContactRow">
                  <Grid Margin="16,0,0,0">
                    <StackPanel Margin="0,10,16,10" Spacing="2">
                      <TextBlock Text="{Binding Label}" FontSize="13" Classes="secondary"/>
                      <SelectableTextBlock Text="{Binding Value}" Foreground="{DynamicResource IosBlue}" FontSize="15"/>
                    </StackPanel>
                    <Border Classes="separator"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
