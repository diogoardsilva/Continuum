<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Continuum.ViewModels"
             x:Class="Continuum.Views.PhoneView"
             x:DataType="vm:PhoneViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.name.missed">
      <Setter Property="Foreground" Value="{DynamicResource IosRed}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource IosBackground}">
    <TextBlock Grid.Row="0" Classes="largeTitle" Text="Recentes" Margin="16,4,16,8"/>
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Recents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CallItem">
            <Grid ColumnDefinitions="22,Auto,*" Margin="8,0,0,0">
              <PathIcon Grid.Column="0" Data="M9,5V7H15.59L4,18.59L5.41,20L17,8.41V15H19V5H9Z" Width="12" Height="12"
                        Foreground="{DynamicResource IosSecondaryLabel}" IsVisible="{Binding Outgoing}" VerticalAlignment="Center"/>
              <ContentControl Grid.Column="1" Content="{Binding Avatar}" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
              <Grid Grid.Column="2" ColumnDefinitions="*,Auto" Margin="0,9,16,9">
                <StackPanel Spacing="1">
                  <TextBlock Classes="name headline" Classes.missed="{Binding Missed}" Text="{Binding Name}"/>
                  <TextBlock Classes="secondary" Text="{Binding Detail}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Date}" VerticalAlignment="Center"/>
              </Grid>
              <Border Grid.Column="2" Classes="separator"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
