<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Continuum.ViewModels"
             x:Class="Continuum.Views.PhotosAppView"
             x:DataType="vm:PhotosAppViewModel">
  <UserControl.Styles>
    <Style Selector="TextBox.field">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource IosBlue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="12,10"/>
      <!-- Bold keeps white on blue above the 3:1 large/bold text minimum in both appearances. -->
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IosBlue}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Opacity" Value="0.88"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="220,*">
    <!-- Sidebar -->
    <StackPanel Grid.Column="0" Margin="12,52,12,12" Spacing="2">
      <TextBlock Text="Fotos" Classes="caption headline" Margin="8,0,0,6"/>
      <Border Background="{DynamicResource MacSelection}" CornerRadius="8" Padding="8,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="M4,4H20V20H4V4M6,8V18H18V8H6Z" Foreground="White" Width="14" Height="14"/>
          <TextBlock Text="Biblioteca" Foreground="White" FontSize="14"/>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding AccountName}" Classes="caption" Margin="8,16,0,0"/>
    </StackPanel>

    <Border Grid.Column="1" Classes="pane">
      <Grid>
        <!-- Sign in to iCloud.com -->
        <StackPanel IsVisible="{Binding IsSignedOut}" VerticalAlignment="Center" Width="320" Spacing="12">
          <PathIcon Data="M3,13A9,9 0 0,0 12,22C12,17 7.97,13 3,13M12,5.5A2.5,2.5 0 0,1 14.5,8A2.5,2.5 0 0,1 12,10.5A2.5,2.5 0 0,1 9.5,8A2.5,2.5 0 0,1 12,5.5M5.6,10.25A2.5,2.5 0 0,0 8.1,12.75C8.63,12.75 9.12,12.58 9.5,12.31C9.5,12.37 9.5,12.43 9.5,12.5A2.5,2.5 0 0,0 12,15A2.5,2.5 0 0,0 14.5,12.5C14.5,12.43 14.5,12.37 14.5,12.31C14.88,12.58 15.37,12.75 15.9,12.75C17.28,12.75 18.4,11.63 18.4,10.25C18.4,9.25 17.81,8.4 16.97,8C17.81,7.6 18.4,6.74 18.4,5.75C18.4,4.37 17.28,3.25 15.9,3.25C15.37,3.25 14.88,3.41 14.5,3.69C14.5,3.63 14.5,3.56 14.5,3.5A2.5,2.5 0 0,0 12,1A2.5,2.5 0 0,0 9.5,3.5C9.5,3.56 9.5,3.63 9.5,3.69C9.12,3.41 8.63,3.25 8.1,3.25A2.5,2.5 0 0,0 5.6,5.75C5.6,6.74 6.19,7.6 7.03,8C6.19,8.4 5.6,9.25 5.6,10.25M12,22A9,9 0 0,0 21,13C16,13 12,17 12,22Z"
                    Foreground="#FF9F0A" Width="56" Height="56"/>
          <TextBlock Text="Fotos em iCloud" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"
                     Text="Inicia sessão com a tua Apple ID, como no iCloud.com."/>
          <TextBox Classes="field" Watermark="Apple ID" Text="{Binding AppleId}"/>
          <TextBox Classes="field" Watermark="Palavra-passe" PasswordChar="•" Text="{Binding Password}"/>
          <Button Classes="primary" Content="Iniciar sessão" Command="{Binding SignInCommand}" IsDefault="True"/>
          <TextBlock Text="{Binding Message}" Foreground="{DynamicResource IosRed}" TextWrapping="Wrap"
                     TextAlignment="Center" TextTrimming="None" FontSize="13"/>
        </StackPanel>

        <!-- Two-factor code -->
        <StackPanel IsVisible="{Binding NeedsCode}" VerticalAlignment="Center" Width="320" Spacing="12">
          <TextBlock Text="Verificação" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/>
          <TextBox Classes="field" Watermark="000000" Text="{Binding Code}" HorizontalContentAlignment="Center" FontSize="26" MaxLength="6"/>
          <Button Classes="primary" Content="Continuar" Command="{Binding SubmitCodeCommand}" IsDefault="True"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="160"/>
          <TextBlock Classes="secondary" Text="{Binding Message}" HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Classes="secondary" Text="{Binding Message}" IsVisible="{Binding IsUnavailable}"
                   TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None" VerticalAlignment="Center" Margin="48"/>

        <!-- Library grid -->
        <ScrollViewer IsVisible="{Binding IsReady}" Margin="0,44,0,0">
          <ItemsControl ItemsSource="{Binding Photos}" Margin="2">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="160" ItemHeight="160"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhotoTile">
                <Button Classes="plain" Margin="1"
                        Command="{Binding $parent[ItemsControl].((vm:PhotosAppViewModel)DataContext).OpenCommand}"
                        CommandParameter="{Binding}">
                  <Panel Background="{DynamicResource IosFill}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                    <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" Foreground="White" Width="14" Height="14"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" IsVisible="{Binding IsVideo}"/>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Photo viewer -->
        <Grid IsVisible="{Binding IsViewing}" Background="{DynamicResource IosBackground}" RowDefinitions="44,*">
          <Button Grid.Row="0" Classes="plain nav" Command="{Binding CloseCommand}" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Classes="blue" Text="‹ Biblioteca"/>
          </Button>
          <Image Grid.Row="1" Source="{Binding ViewingImage}" Stretch="Uniform" Margin="16"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
