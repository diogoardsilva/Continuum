<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Continuum.ViewModels"
             x:Class="Continuum.Views.CallsAppView"
             x:DataType="vm:CallsAppViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.name.missed">
      <Setter Property="Foreground" Value="{DynamicResource IosRedText}"/>
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.name.missed">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="PathIcon.missedIcon">
      <Setter Property="Foreground" Value="{DynamicResource IosRedText}"/>
    </Style>
    <Style Selector="ListBoxItem:selected PathIcon">
      <Setter Property="Foreground" Value="#D9FFFFFF"/>
    </Style>
    <Style Selector="ToggleButton.segment">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="0,4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource IosCell}"/>
      <Setter Property="Foreground" Value="{DynamicResource IosLabel}"/>
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="320,*">
    <Grid Grid.Column="0" RowDefinitions="44,Auto,*">
      <!-- Segmented control, like Todas | Perdidas on the iPhone -->
      <Border Grid.Row="1" Background="{DynamicResource IosFill}" CornerRadius="9" Padding="2" Margin="16,0,16,8">
        <UniformGrid Columns="2">
          <ToggleButton Classes="segment" Content="Todas" IsChecked="{Binding !MissedOnly}"/>
          <ToggleButton Classes="segment" Content="Perdidas" IsChecked="{Binding MissedOnly}"/>
        </UniformGrid>
      </Border>
      <ListBox Grid.Row="2" Classes="sidebar" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CallItem">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ContentControl Grid.Column="0" Content="{Binding Avatar}" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="name headline" Classes.missed="{Binding Missed}" Text="{Binding Name}" FontSize="14"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="M9,5V7H15.59L4,18.59L5.41,20L17,8.41V15H19V5H9Z" Width="9" Height="9"
                            Foreground="{DynamicResource IosSecondaryLabel}" IsVisible="{Binding Outgoing}"/>
                  <PathIcon Classes="missedIcon" Data="M23.71,16.67C20.66,13.78 16.54,12 12,12C7.46,12 3.34,13.78 0.29,16.67C0.11,16.85 0,17.1 0,17.38C0,17.66 0.11,17.91 0.29,18.09L2.77,20.57C2.95,20.75 3.2,20.86 3.5,20.86C3.75,20.86 4,20.75 4.18,20.58C4.97,19.84 5.87,19.22 6.84,18.73C7.17,18.57 7.4,18.23 7.4,17.83V14.73C8.85,14.25 10.4,14 12,14C13.6,14 15.15,14.25 16.6,14.72V17.82C16.6,18.22 16.83,18.56 17.16,18.72C18.14,19.21 19.03,19.84 19.83,20.57C20,20.75 20.25,20.85 20.5,20.85C20.8,20.85 21.05,20.74 21.23,20.56L23.71,18.08C23.89,17.9 24,17.65 24,17.37C24,17.09 23.88,16.85 23.71,16.67M6.5,5.5L12,11L19,4L18,3L12,9L7.5,4.5H11V3H5V9H6.5V5.5Z"
                            Width="11" Height="11" IsVisible="{Binding Missed}"/>
                  <TextBlock Classes="secondary" Text="{Binding Detail}" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Date}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Border Grid.Column="1" Classes="pane">
      <StackPanel DataContext="{Binding Detail}" x:DataType="vm:CallDetail" Spacing="14" Margin="48,72,48,32" MaxWidth="520">
        <ContentControl Content="{Binding Item.Avatar}" Width="110" Height="110" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Item.Name}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <Border Classes="card" Padding="16,12">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding When}" Classes="headline" FontSize="15"/>
            <TextBlock Text="{Binding What}" Classes="secondary"/>
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding HasCard}">
          <ItemsControl ItemsSource="{Binding Card.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContactRow">
                <Grid Margin="16,0,0,0">
                  <StackPanel Margin="0,10,16,10" Spacing="2">
                    <TextBlock Text="{Binding Label}" FontSize="13" Classes="secondary"/>
                    <SelectableTextBlock Classes="value" Text="{Binding Value}"/>
                  </StackPanel>
                  <Border Classes="separator"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"
                   Text="Fazer e atender chamadas a partir do PC chega com a ligação Bluetooth ao iPhone."/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
